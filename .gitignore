# Binaries
/goMqttModbus
/goMqttDnp3
/goMqttDnp3-arm
/gatewayIcr323x
/gatewayWin
*.exe
*.test
*.out

# Runtime config (use configs/example.json as template)
/config.json
/config.*.json

# Local TLS certs/keys (use `make dev-cert`)
*.pem

# Frontend build artifacts (embed_prod.go embeds from web/dist at build time)
/web/dist/
/web/node_modules/
/web/package-lock.json

# Container artifacts
*.tar

# Generated init.d service script (made by `make service-icr`)
*.init

# OS / editor / agent
.DS_Store
*.swp
.idea/
.vscode/
.claude/

# opendnp3 is vendored locally per build host via `make opendnp3-vendor[-arm]`
# (fetches source, builds static libs + headers into third_party/opendnp3/).
# It's large and fully reproducible from scripts/build-opendnp3.sh, so none of
# it is committed — run the vendor target before an ffi build.
/build/opendnp3/
third_party/opendnp3/
